---
interface Props {
    words: string[];
}

const { words } = Astro.props as Props;
const fallbackWords = ["Backend", "Fullstack", "Frontend"];
const roleWords = words.length > 0 ? words : fallbackWords;
const roleClasses = [
    "text-transparent bg-clip-text bg-gradient-to-r from-violet-500 to-fuchsia-500",
    "text-transparent bg-clip-text bg-gradient-to-r from-sky-500 to-blue-700",
    "text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-orange-500",
];
---

<span class="text-rotate flex flex-col items-center justify-center overflow-hidden text-2xl font-extrabold leading-none sm:text-3xl">
    <span>
        {roleWords.map((word, index) => (
            <span class={roleClasses[index % roleClasses.length]}>{word}</span>
        ))}
    </span>
</span>
