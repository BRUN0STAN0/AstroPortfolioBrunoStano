---
import type { Translations } from "../i18n/translations";

interface Props {
  t: Translations;
}

const { t } = Astro.props as Props;
---

<section
  id="numeri"
  class="w-full rounded-2xl bg-gradient-to-br from-primary/35 via-base-100/60 to-secondary/35 p-6 shadow-lg ring-1 ring-base-300/60 backdrop-blur-sm sm:p-8"
>
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-base-content/60">
        {t.statistics.label}
      </p>
      <h2 class="text-2xl font-bold text-base-content sm:text-3xl">
        {t.statistics.title}
      </h2>
      <p class="mt-2 max-w-xl text-sm text-base-content/80 sm:text-base">
        {t.statistics.description}
      </p>
    </div>
  </div>

  <div class="stats stats-vertical gap-4 sm:stats-horizontal bg-base-100/80 text-base-content">
    <div class="stat">
      <div class="stat-title">{t.statistics.first.title}</div>
      <div class="stat-value text-primary">3+</div>
      <div class="stat-desc">
        {t.statistics.first.description}
      </div>
    </div>

    <div class="stat">
      <div class="stat-title">{t.statistics.second.title}</div>
      <div class="stat-value text-secondary">1000+</div>
      <div class="stat-desc">
        {t.statistics.second.description}
      </div>
    </div>

    <div class="stat">
      <div class="stat-title">{t.statistics.third.title}</div>
      <div class="stat-value text-accent">20+</div>
      <div class="stat-desc">
        {t.statistics.third.description}
      </div>
    </div>
  </div>
</section>