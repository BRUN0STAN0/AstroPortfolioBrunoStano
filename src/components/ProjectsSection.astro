---
import type { Translations } from "../i18n/translations";

interface Props {
  t: Translations;
}

const { t } = Astro.props as Props;
---

<section
  id="progetti"
  class="w-full rounded-2xl bg-gradient-to-br from-secondary/35 via-base-100/60 to-accent/35 p-6 shadow-lg ring-1 ring-base-300/70 backdrop-blur-sm sm:p-8"
>
  <header class="mb-6 space-y-2">
    <p class="text-xs font-semibold uppercase tracking-[0.35em] text-base-content/60">
      {t.projects.label}
    </p>
    <h2 class="text-2xl font-bold text-base-content sm:text-3xl">
      {t.projects.title}
    </h2>
    <p class="max-w-2xl text-sm text-base-content/80 sm:text-base">
      {t.projects.description}
    </p>
  </header>

  <div class="grid gap-5 md:grid-cols-3">
    {t.projects.items.map((project) => (
      <article class="flex flex-col gap-3 rounded-xl bg-base-100  p-4">
        <h3 class="text-base font-semibold text-base-content">
          {project.title}
        </h3>
        <p class="text-sm text-base-content/80">
          {project.description}
        </p>
        <p class="text-xs font-medium uppercase tracking-wide text-primary">
          {t.projects.stackLabel}
        </p>
        <p class="text-xs text-base-content/75">
          {project.stack}
        </p>
      </article>
    ))}
  </div>
</section>

