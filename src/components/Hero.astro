---
import RotatingWords from "./RotatingWords.astro";
import type { Translations } from "../i18n/translations";
import BrunoStanoImage from "../assets/BrunoStano.png";

interface Props {
  t: Translations;
}

const { t } = Astro.props as Props;
---

<section
  id="hero"
  class="hero bg-base-200/80 dark:bg-base-200/40 min-h-[70vh]"
  data-aos="fade-up"
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-col gap-10 px-3 py-10 sm:px-4 lg:grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-center lg:gap-10 lg:py-16"
  >
    <!-- Left: intro, copy, CTA -->
    <div class="space-y-6 text-left" data-aos="fade-right" data-aos-delay="120">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-base-content/60">
        {t.hero.label}
      </p>

      <div class="space-y-3">
        <h1
          class="text-3xl font-bold leading-tight text-base-content sm:text-4xl lg:text-5xl"
        >
          {t.hero.hello}
          <span class="text-primary">{t.hero.name}</span>
        </h1>

        <div
          class="inline-flex flex-wrap items-center gap-3 rounded-full bg-base-100/85 px-5 py-3 text-base font-semibold text-base-content/90 shadow-sm ring-1 ring-base-300/70 sm:px-6 sm:py-4"
        >
          <span class="text-sm uppercase tracking-[0.2em] text-primary sm:text-base">
            {t.hero.rolesLabel}
          </span>
          <span class="h-7 w-px bg-base-300/70"></span>
          <RotatingWords words={t.hero.roles} />
        </div>
      </div>

      <p class="max-w-xl text-sm text-base-content/80 sm:text-base">
        {t.hero.description}
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          class="btn btn-primary btn-sm sm:btn-md shadow-md shadow-primary/25"
          href="#timeline"
        >
          {t.hero.ctaJourney}
        </a>
        <a
          class="btn btn-ghost btn-sm sm:btn-md border-base-300/70 text-base-content/80 hover:border-base-300 hover:bg-base-200"
          href="mailto:contact@brunostano.com"
        >
          {t.hero.ctaContact}
        </a>
      </div>
    </div>

    <!-- Right: foto + elementi grafici & animazioni -->
    <div class="relative flex items-center justify-center" data-aos="zoom-in" data-aos-delay="180">
      <!-- Blob sfocato di sfondo -->
      <div
        class="pointer-events-none absolute inset-0 -z-10 mx-auto max-w-sm rounded-full bg-gradient-to-tr from-primary/75 via-secondary/65 to-accent/75 opacity-80 blur-3xl"
      ></div>

      <div class="grid w-full max-w-md gap-4">
        <div
          data-aos="fade-left"
          data-aos-delay="240"
          class="flex items-center gap-4 rounded-2xl bg-base-100/95 p-4 shadow-xl ring-1 ring-base-300/70"
        >
          <div class="relative h-16 w-16 shrink-0">
            <div
              class="absolute inset-0 -z-10 rounded-2xl bg-gradient-to-tr from-primary/70 to-secondary/70 blur-md"
            ></div>
            <img
              src={BrunoStanoImage.src}
              alt={t.hero.photoAlt}
              class="h-16 w-16 rounded-2xl object-cover shadow-md"
            />
          </div>
          <div class="space-y-1">
            <p class="text-sm font-semibold text-base-content">
              {t.hero.name}
            </p>
            <p class="text-xs text-base-content/70">
              {t.hero.cardRole}
            </p>
            <p class="text-[11px] text-base-content/60">
              {t.hero.cardDescription}
            </p>
          </div>
        </div>

        <div
          data-aos="fade-left"
          data-aos-delay="320"
          class="group rounded-2xl bg-base-100/95 p-4 shadow-xl ring-1 ring-base-300/70 transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        >
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-primary">
            {t.hero.focusLabel}
          </p>
          <p class="mt-2 text-sm font-medium text-base-content">
            {t.hero.focusDescription}
          </p>
          <div class="mt-3 flex flex-wrap gap-2 text-[11px] text-base-content/80">
            <span class="badge badge-sm badge-outline border-primary/60 text-primary">
              .NET
            </span>
            <span class="badge badge-sm badge-outline border-primary/60 text-primary">
              C#
            </span>
            <span class="badge badge-sm badge-outline border-secondary/60 text-secondary">
              Blazor
            </span>
            <span class="badge badge-sm badge-outline border-accent/60 text-accent">
              Azure DevOps
            </span>
          </div>
        </div>

        <div class="flex gap-4" data-aos="fade-up" data-aos-delay="400">
          <div
            class="flex-1 rounded-2xl bg-base-100/95 p-4 shadow-lg ring-1 ring-base-300/70 animate-pulse"
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-base-content/70">
              {t.hero.nowLabel}
            </p>
            <p class="mt-2 text-sm font-semibold text-base-content">
              {t.hero.nowTitle}
            </p>
            <p class="text-xs text-base-content/70">
              {t.hero.nowDescription}
            </p>
          </div>

          <div class="w-20 [perspective:900px]">
            <div
              data-mouse-tilt
              data-tilt-intensity="10"
              class="flex w-20 flex-col items-center justify-center gap-2 rounded-2xl bg-base-100/90 p-3 text-center shadow-lg ring-1 ring-base-300/70 transition-transform duration-200 ease-out [transform-style:preserve-3d]"
            >
              <span class="text-[10px] font-semibold uppercase tracking-wide text-base-content/70">
                {t.hero.experienceLabel}
              </span>
              <span class="text-xl font-bold text-primary">3+</span>
              <span class="text-[10px] text-base-content/60">{t.hero.yearsLabel}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
