---
import TimeLine from "./TimeLine.astro";
import type { Translations } from "../i18n/translations";

interface Props {
  t: Translations;
}

const { t } = Astro.props as Props;
---

<section
  id="timeline"
  class="w-full rounded-2xl bg-gradient-to-br from-accent/35 via-base-100/60 to-primary/30 p-6 shadow-lg ring-1 ring-base-300/70 backdrop-blur-sm sm:p-8"
>
  <header class="mb-6 space-y-2">
    <p class="text-xs font-semibold uppercase tracking-[0.35em] text-base-content/60">
      {t.journey.label}
    </p>
    <h2 class="text-2xl font-bold text-base-content sm:text-3xl">
      {t.journey.title}
    </h2>
    <p class="max-w-2xl text-sm text-base-content/80 sm:text-base">
      {t.journey.description}
    </p>
  </header>

  <div class="max-h-[70vh] overflow-y-auto rounded-xl bg-base-100/90 p-4 shadow-inner sm:p-5">
    <TimeLine items={t.journey.timeline} />
  </div>
</section>

