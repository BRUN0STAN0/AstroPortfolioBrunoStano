---
import type { Locale, Translations } from "../i18n/translations";
import itFlag from "../assets/flags/it.png";
import enFlag from "../assets/flags/en.png";
import frFlag from "../assets/flags/fr.png";

interface Props {
  lang: Locale;
  t: Translations;
}

const { lang, t } = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL;
const flags = {
  it: { src: itFlag.src, alt: "Italian flag", label: "IT" },
  en: { src: enFlag.src, alt: "English flag", label: "EN" },
  fr: { src: frFlag.src, alt: "French flag", label: "FR" },
};
const localeLinks = {
  it: `${baseUrl}it/`,
  en: `${baseUrl}en/`,
  fr: `${baseUrl}fr/`,
};
---

<div class="navbar navbar relative z-50 text-white border border-base-300/40 shadow-md
            bg-slate-900
            [html[data-theme=dark]_&]:text-slate-900
            [html[data-theme=dark]_&]:bg-slate-100">
  <div class="navbar-start">

    <div class="dropdown">
      <!-- For mobile view -->
      <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /> </svg>
      </div>
      
      <ul
        tabindex="-1"
        class="menu menu-sm dropdown-content bg-base-content rounded-box z-[60] mt-3 w-52 p-2 shadow">
        <li><a href="#hero">{t.nav.hero}</a></li>
        <li><a href="#numeri">{t.nav.numbers}</a></li>
        <li><a href="#dotnet">{t.nav.dotnet}</a></li>
        <li><a href="#timeline">{t.nav.journey}</a></li>
        <li><a href="#progetti">{t.nav.projects}</a></li>
        <li><a href="#skills">{t.nav.skills}</a></li>
        <li><a href="#contatti">{t.nav.contacts}</a></li>
      </ul>
    </div>
    <a href="#hero" class="btn btn-ghost text-xl">{t.nav.brand}</a>

  </div>
  <div class="navbar-center hidden lg:flex">

    <ul class="menu menu-horizontal px-1">
      <li><a href="#hero">{t.nav.hero}</a></li>
      <li><a href="#numeri">{t.nav.numbers}</a></li>
      <li><a href="#dotnet">{t.nav.dotnet}</a></li>
      <li><a href="#timeline">{t.nav.journey}</a></li>
      <li><a href="#progetti">{t.nav.projects}</a></li>
      <li><a href="#skills">{t.nav.skills}</a></li>
      <li><a href="#contatti">{t.nav.contacts}</a></li>
    </ul>

  </div>
  <div class="navbar-end gap-2">
    <div class="dropdown dropdown-end">
      <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-2">
        <span>{t.common.language}: {lang.toUpperCase()}</span>
        <img src={flags[lang].src} alt={flags[lang].alt} class="inline-block w-4 h-4" />
      </div>
      <ul
        tabindex="-1"
        class="menu menu-sm dropdown-content bg-base-content rounded-box z-[60] mt-3 w-36 p-2 shadow"
      >
        <li>
          <a href={localeLinks.it} class="flex items-center justify-between">
            <span>IT</span>
            <img src={flags.it.src} alt={flags.it.alt} class="inline-block w-4 h-4 ml-2" />
          </a>
        </li>
        <li>
          <a href={localeLinks.en} class="flex items-center justify-between">
            <span>EN</span>
            <img src={flags.en.src} alt={flags.en.alt} class="inline-block w-4 h-4 ml-2" />
          </a>
        </li>
        <li>
          <a href={localeLinks.fr} class="flex items-center justify-between">
            <span>FR</span>
            <img src={flags.fr.src} alt={flags.fr.alt} class="inline-block w-4 h-4 ml-2" />
          </a>
        </li>
      </ul>
    </div>
    <a
      class="btn bg-green-500 text-black btn-sm"
      href="mailto:contact@brunostano.com"
    >
      {t.nav.cta}
    </a>
  </div>
</div>
