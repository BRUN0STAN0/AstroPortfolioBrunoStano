---
import Hero from "./Hero.astro";
import NavBar from "./NavBar.astro";
import Statistics from "./Statistics.astro";
import ButtonTheme from "./ButtonTheme.astro";
---

<div
  class="mockup-browser w-full p-5 bg-accent rounded-none shadow-lg hover:shadow-2xl"
>
  <div class="bg-base-200 rounded-lg">
    <div class="mockup-browser-toolbar">
      <div class="input text-bold">https://brunostano.com</div>
      <ButtonTheme />
    </div>
    <NavBar />
    <div class="m-4 min-h-[82vh] max-h-[82vh] overflow-y-auto">
      <Hero />
      <div
        class="w-full flex items-center justify-center w-full h-full min-h-[120vh]"
      >
        <Statistics />
      </div>
    </div>
  </div>
</div>

<style>
  body {
    overflow: hidden;
  }
</style>
