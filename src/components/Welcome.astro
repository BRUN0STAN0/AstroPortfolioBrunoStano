---
import Hero from "./Hero.astro";
import NavBar from "./NavBar.astro";
import Statistics from "./Statistics.astro";
import DotNetSection from "./DotNetSection.astro";
import JourneySection from "./JourneySection.astro";
import ProjectsSection from "./ProjectsSection.astro";
import SkillsSection from "./SkillsSection.astro";
import ContactSection from "./ContactSection.astro";
import ButtonTheme from "./ButtonTheme.astro";
import type { Locale, Translations } from "../i18n/translations";

interface Props {
  lang: Locale;
  t: Translations;
}

const { lang, t } = Astro.props as Props;
---

<div
  class="mockup-browser flex min-h-screen w-full items-center justify-center p-5 rounded-none shadow-lg hover:shadow-2xl bg-gradient-to-br from-slate-950/95 via-indigo-950/90 to-cyan-950/90 [html[data-theme=dark]_&]:bg-gradient-to-br [html[data-theme=dark]_&]:from-cyan-100 [html[data-theme=dark]_&]:via-emerald-100 [html[data-theme=dark]_&]:to-yellow-100"
  data-aos="zoom-out-up"
  data-aos-duration="900"
>
  <div class="bg-base-200 border-2 border-base-content/25 rounded-lg flex h-[90vh] w-full max-w-[90vw] flex-col shadow-[0_20px_60px_-15px_rgba(0,0,0,0.7)] ring-1 ring-primary/20">
    <div class="mockup-browser-toolbar">
      <div class="input text-lg font-medium min-w-[30vw] flex items-center justify-center text-center">https://brunostano.com</div>
      <ButtonTheme t={t} />
    </div>
    <div data-aos="fade-down" data-aos-delay="80">
      <NavBar lang={lang} t={t} />
    </div>
    <div class="m-4 flex-1 overflow-y-auto pr-2" data-aos-scroll-container>
      <main class="pb-8">
        <div
          class="mx-auto flex w-full max-w-7xl flex-col gap-40 px-3 sm:px-4 mb-50"
        >
          <Hero t={t} />
          <Statistics t={t} />
          <DotNetSection t={t} />
          <JourneySection t={t} />
          <ProjectsSection t={t} />
          <SkillsSection t={t} />
          <ContactSection t={t} />
        </div>
      </main>
    </div>
  </div>
</div>
