---
import Hero from "./Hero.astro";
import NavBar from "./NavBar.astro";
import Statistics from "./Statistics.astro";
import DotNetSection from "./DotNetSection.astro";
import JourneySection from "./JourneySection.astro";
import ProjectsSection from "./ProjectsSection.astro";
import SkillsSection from "./SkillsSection.astro";
import ContactSection from "./ContactSection.astro";
import ButtonTheme from "./ButtonTheme.astro";
import type { Locale, Translations } from "../i18n/translations";

interface Props {
  lang: Locale;
  t: Translations;
}

const { lang, t } = Astro.props as Props;
const searchPlaceholderByLocale = {
  it: "Premi Invio per cercare nel sito o aprire un URL",
  en: "Press Enter to search the site or open a URL",
  fr: "Appuyez sur Entree pour rechercher dans le site ou ouvrir une URL",
};
const backToSiteByLocale = {
  it: "Torna al portfolio",
  en: "Back to portfolio",
  fr: "Retour au portfolio",
};
---

<div
  class="mockup-browser flex min-h-screen w-full items-center justify-center p-5 rounded-none shadow-lg hover:shadow-2xl bg-transparent"
  data-aos="zoom-out-up"
  data-aos-duration="900"
>
  <div class="bg-base-200 border-2 border-base-content/25 rounded-lg flex h-[90vh] w-full max-w-[90vw] flex-col shadow-[0_20px_60px_-15px_rgba(0,0,0,0.7)] ring-1 ring-primary/20">
    <div class="mockup-browser-toolbar grid grid-cols-[1fr_minmax(0,32rem)_1fr] items-center gap-2">
      <form class="col-start-2 flex min-w-0 w-full items-center justify-self-center" data-site-search-form>
        <input
          class="input input-bordered input-sm h-10 w-full rounded-xl border-slate-300 bg-slate-100 text-slate-700 placeholder:text-slate-500 pr-10 font-medium shadow-inner focus:border-slate-400 focus:outline-none"
          type="text"
          name="query"
          data-site-search-input
          autocomplete="off"
          spellcheck="false"
          placeholder={searchPlaceholderByLocale[lang]}
        />
      </form>
      <div class="col-start-3 justify-self-end">
        <ButtonTheme t={t} />
      </div>
    </div>
    <div class="relative z-50" data-aos="fade-down" data-aos-delay="80">
      <NavBar lang={lang} t={t} />
    </div>

    <div class="m-4 hidden min-h-0 flex-1 flex-col gap-3 overflow-hidden" data-embed-view>
      <div class="flex items-center justify-between rounded-xl border border-base-300/60 bg-base-100/90 px-3 py-2">
        <p class="truncate text-xs text-base-content/70" data-embed-url></p>
        <div class="flex items-center gap-2">
          <a class="btn btn-xs btn-ghost" href="#" target="_blank" rel="noopener noreferrer" data-embed-open-external>Apri esternamente</a>
          <button class="btn btn-xs" type="button" data-embed-close>{backToSiteByLocale[lang]}</button>
        </div>
      </div>
      <div class="hidden rounded-xl border border-warning/40 bg-warning/10 px-3 py-2 text-xs text-warning-content" data-embed-warning>
        Il sito potrebbe bloccare l'apertura in iframe. Link aperto anche esternamente.
      </div>
      <iframe
        class="h-full min-h-0 w-full flex-1 rounded-xl border border-base-300/60 bg-white"
        title="External site preview"
        loading="lazy"
        referrerpolicy="no-referrer"
        data-embed-iframe
      ></iframe>
    </div>

    <div class="m-4 min-h-0 flex-1 overflow-y-auto pr-2" data-aos-scroll-container data-site-content>
      <main class="pb-8">
        <div
          class="mx-auto flex w-full max-w-7xl flex-col gap-40 px-3 sm:px-4 mb-50"
        >
          <Hero t={t} />
          <Statistics t={t} />
          <DotNetSection t={t} />
          <JourneySection t={t} />
          <ProjectsSection t={t} />
          <SkillsSection t={t} />
          <ContactSection t={t} />
        </div>
      </main>
    </div>
  </div>
</div>
