---
import type { Translations } from "../i18n/translations";

interface Props {
  t: Translations;
}

const { t } = Astro.props as Props;
---

<section
  id="skills"
  class="w-full rounded-2xl bg-gradient-to-br from-success/35 via-base-100/60 to-primary/30 p-6 shadow-lg ring-1 ring-base-300/70 backdrop-blur-sm sm:p-8"
>
  <header class="mb-6 space-y-2">
    <p class="text-xs font-semibold uppercase tracking-[0.35em] text-base-content/60">
      {t.skills.label}
    </p>
    <h2 class="text-2xl font-bold text-base-content sm:text-3xl">
      {t.skills.title}
    </h2>
    <p class="max-w-2xl text-sm text-base-content/80 sm:text-base">
      {t.skills.description}
    </p>
  </header>

  <div class="grid gap-5 md:grid-cols-3">
    <div class="space-y-2 rounded-xl bg-base-100  p-4">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">
        {t.skills.softTitle}
      </h3>
      <ul class="space-y-1 text-sm text-base-content/80">
        {t.skills.softItems.map((item) => (
          <li>· {item}</li>
        ))}
      </ul>
    </div>

    <div class="space-y-2 rounded-xl bg-base-100  p-4">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">
        {t.skills.languagesTitle}
      </h3>
      <ul class="space-y-1 text-sm text-base-content/80">
        {t.skills.languageItems.map((item) => (
          <li>· {item}</li>
        ))}
      </ul>
    </div>

    <div class="space-y-2 rounded-xl bg-base-100  p-4">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">
        {t.skills.workModeTitle}
      </h3>
      <ul class="space-y-1 text-sm text-base-content/80">
        {t.skills.workModeItems.map((item) => (
          <li>· {item}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

