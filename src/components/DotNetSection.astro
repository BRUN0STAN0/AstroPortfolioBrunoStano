---
import type { Translations } from "../i18n/translations";

interface Props {
  t: Translations;
}

const { t } = Astro.props as Props;
---

<section
  id="dotnet"
  class="w-full rounded-2xl bg-gradient-to-br from-secondary/35 via-base-100/60 to-accent/35 p-6 shadow-lg ring-1 ring-base-300/60 backdrop-blur-sm sm:p-8"
>
  <div class="grid gap-8 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] md:items-start">
    <div class="space-y-4">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-base-content/60">
        {t.dotnet.label}
      </p>
      <h2 class="text-2xl font-bold text-base-content sm:text-3xl">
        {t.dotnet.title}
      </h2>
      <p class="text-sm text-base-content/80 sm:text-base">
        {t.dotnet.description}
      </p>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">
            {t.dotnet.backendTitle}
          </h3>
          <ul class="space-y-1 text-sm text-base-content/85">
            {t.dotnet.backendItems.map((item) => (
              <li>· {item}</li>
            ))}
          </ul>
        </div>

        <div class="space-y-2">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">
            {t.dotnet.frontendTitle}
          </h3>
          <ul class="space-y-1 text-sm text-base-content/85">
            {t.dotnet.frontendItems.map((item) => (
              <li>· {item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="space-y-4 rounded-2xl bg-base-100 p-4 text-sm text-base-content/85">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">
        {t.dotnet.devopsTitle}
      </h3>
      <ul class="space-y-1">
        {t.dotnet.devopsItems.map((item) => (
          <li>· {item}</li>
        ))}
      </ul>

      <div class="mt-4 rounded-xl bg-base-100 p-3 text-xs text-base-content/75">
        {t.dotnet.boxText}
        <a
          href="mailto:contact@brunostano.com"
          class="font-semibold text-primary underline-offset-2 hover:underline"
        >
          contact@brunostano.com
        </a>
      </div>
    </div>
  </div>
</section>

