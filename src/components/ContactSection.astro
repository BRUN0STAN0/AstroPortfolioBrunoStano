---
import type { Translations } from "../i18n/translations";

interface Props {
  t: Translations;
}

const { t } = Astro.props as Props;
---

<section
  id="contatti"
  class="w-full rounded-2xl bg-gradient-to-br from-secondary/30 via-base-100/60 to-primary/35 p-6 shadow-lg ring-1 ring-base-300/70 backdrop-blur-sm sm:p-8"
>
  <header class="mb-6 space-y-2">
    <p class="text-xs font-semibold uppercase tracking-[0.35em] text-base-content/60">
      {t.contact.label}
    </p>
    <h2 class="text-2xl font-bold text-base-content sm:text-3xl">
      {t.contact.title}
    </h2>
    <p class="max-w-xl text-sm text-base-content/80 sm:text-base">
      {t.contact.description}
    </p>
  </header>

  <div class="grid gap-6 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] md:items-start">
    <div class="space-y-3 text-sm text-base-content/85">
      <p>
        {t.contact.intro}
      </p>
      <div class="space-y-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-primary">
          {t.contact.emailLabel}
        </p>
        <a
          href="mailto:contact@brunostano.com"
          class="text-sm font-medium text-primary underline-offset-2 hover:underline"
        >
          contact@brunostano.com
        </a>
      </div>

      <div class="space-y-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-primary">
          {t.contact.phoneLabel}
        </p>
        <p class="text-sm text-base-content/85">
          +39 389 899 64 61
        </p>
      </div>

      <div class="space-y-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-primary">
          {t.contact.availabilityLabel}
        </p>
        <p class="text-sm text-base-content/85">
          {t.contact.availabilityText}
        </p>
      </div>
    </div>

    <div class="space-y-3 rounded-xl bg-gradient-to-br from-base-200/90 to-primary/25 p-4 text-xs text-base-content/80">
      <p class="font-semibold text-base-content">
        {t.contact.whyTitle}
      </p>
      <ul class="space-y-1">
        {t.contact.whyItems.map((item) => (
          <li>· {item}</li>
        ))}
      </ul>
      <p class="pt-2 text-base-content/70">
        {t.contact.callText}
      </p>
    </div>
  </div>
</section>

