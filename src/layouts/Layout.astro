---
import "../styles/global.css";
import "aos/dist/aos.css";

interface Props {
	lang?: string;
	title?: string;
}

const { lang = "it", title = "Portfolio" } = Astro.props as Props;
---

<!doctype html>

<html lang={lang} data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<canvas id="network-bg" aria-hidden="true"></canvas>
		<div class="page-content">
		<slot />
		</div>
		<script>
			import { initNetworkBackground } from "../scripts/networkBackground.js";
			import { initAosObservers } from "../scripts/aosObserver.js";
			import { initMouseTilt } from "../scripts/mouseTilt.js";

			initNetworkBackground();
			initAosObservers();
			initMouseTilt();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	#network-bg {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.page-content {
		position: relative;
		z-index: 1;
	}
</style>
